<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             MODULE CATEGORY
             ============================================================ -->
        <record id="module_category_hr_anonymous_message" model="ir.module.category">
            <field name="name">Anonymous HR Messages</field>
            <field name="description">
                Manage permissions for the Anonymous HR Messages module.
            </field>
            <field name="sequence">20</field>
        </record>

        <!-- ============================================================
             PRIVILEGE
             Creates the "Anonymous HR Role" dropdown on the user
             Access Rights tab under "ANONYMOUS HR MESSAGES" section.
             ============================================================ -->
        <record id="privilege_hr_anonymous" model="res.groups.privilege">
            <field name="name">Anonymous HR Role</field>
            <field name="category_id" ref="module_category_hr_anonymous_message"/>
        </record>

        <!-- ============================================================
             GROUP 1 — Employee (default)
             ============================================================ -->
        <record id="group_hr_anonymous_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_hr_anonymous"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ============================================================
             GROUP 2 — HR Staff
             NOTE: Do NOT imply hr.group_hr_user here — it belongs to
             a different privilege and causes the group to disappear
             from the dropdown. Access is controlled via ir.model.access
             and domain rules instead.
             ============================================================ -->
        <record id="group_hr_anonymous_staff" model="res.groups">
            <field name="name">HR Staff</field>
            <field name="privilege_id" ref="privilege_hr_anonymous"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hr_anonymous_admin" model="res.groups">
            <field name="name">System Admin</field>
            <field name="privilege_id" ref="privilege_hr_anonymous"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>